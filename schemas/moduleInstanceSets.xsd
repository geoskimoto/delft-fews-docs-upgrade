<?xml version="1.0" encoding="UTF-8"?>
<!--Delft FEWS (Copyright 2003 WL | Delft Hydraulics) -->
<schema targetNamespace="http://www.wldelft.nl/fews" xmlns:fews="http://www.wldelft.nl/fews"
    xmlns="http://www.w3.org/2001/XMLSchema"  elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
    <include schemaLocation="sharedTypes.xsd"/>
    <element name="moduleInstanceSets" type="fews:ModuleInstanceSetsComplexType"/>
    <!--    -->
    <!--ModuleInstanceSetComplex Type-->
    <complexType name="ModuleInstanceSetComplexType">
        <sequence>
            <element name="description" type="string" minOccurs="0"/>
			<choice maxOccurs="unbounded">
				<element name="moduleInstanceId" type="fews:idStringType">
					<key name="moduleInstanceId">
						<selector xpath="fews:moduleInstanceId"/>
						<field xpath="@id"/>
					</key>
				</element>
				<element name="moduleInstanceIdPattern" type="fews:idStringType">
					<annotation>
						<documentation> * and ? can be used, eg *_Rainfall_Forecast</documentation>
					</annotation>
				</element>
			</choice>
        </sequence>
        <attribute name="id" type="fews:idStringType" use="required"/>
        <attribute name="name" type="fews:nameStringType" use="optional"/>
    </complexType>
<!---->
    <complexType name="ModuleInstanceSetsComplexType">
        <sequence>
            <element name="moduleInstanceSet" type="fews:ModuleInstanceSetComplexType" maxOccurs="unbounded">
                <key name="moduleInstanceSet">
                    <selector xpath="."/>
                    <field xpath="@id"/>
                </key>
            </element>
        </sequence>
        <attribute name="version" type="fews:versionStringType" use="required" fixed="1.1"/>
    </complexType>

</schema>
