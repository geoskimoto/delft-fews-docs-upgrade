						</annotation>
					</element>
					<group ref="fews:WmsVersionAndGeoDatumSequence"/>
					<group ref="fews:WmsImageOptionsGroup"/>
					<group ref="fews:WmsVendorParametersGroup"/>
					<element name="cacheDir" type="fews:directoryStringType">
						<annotation>
							<documentation>
